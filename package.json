{
  "name": "job-application-helper",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "build:extension": "npm run build --workspace extension",
    "dev:extension": "npm run dev --workspace extension",
    "test": "npm run test --workspace api",
    "mcp": "npm run mcp --workspace api",
    "eval:seed": "tsx scripts/seed-eval.ts",
    "eval:run": "tsx scripts/eval-regression.ts",
    "rescore:tracker": "npm run rescore:tracker --workspace api",
    "rescore:tracker-all": "npm run rescore:tracker-all --workspace api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
